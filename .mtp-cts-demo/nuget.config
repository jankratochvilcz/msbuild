<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin to nuget.org ONLY so the demo builds on public GitHub Actions runners
  without needing the internal DevDiv feed (which is where the real 'cts'
  tool lives).

  <clear/> under packageSources drops the repo-root feeds; the explicit
  packageSourceMapping (also cleared, then wildcarded to nuget.org) overrides
  the repo root's PackageSourceMapping, which would otherwise refuse to resolve
  xunit.v3 from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
