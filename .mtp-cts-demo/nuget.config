<?xml version="1.0" encoding="utf-8"?>
<!--
  Pin to nuget.org ONLY so the demo builds on public GitHub Actions runners
  without needing the internal DevDiv feed (which is where the real 'cts'
  tool lives). <clear/> drops the repo-root feeds we would otherwise inherit.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
